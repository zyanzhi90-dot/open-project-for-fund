  {
    "id": "P-8699ee45e66d",
    "判断": "窗口或任务未取得",
    "来源URL": "https://kjt.shaanxi.gov.cn/kjdt/tzgg/201812/P020250118814534976247.pdf | https://iair.xjtu.edu.cn/yjspy/info/1004/1229.htm",
    "截止原句": "会议时间：7月21日 11:00-12:00 报名二维码： （请参加宣讲会的同学扫二维码报名，报名截止时间：7月15日18:00） 人才培养历史沿革 人才培养历史沿革 1982年 在“控制科学与工程”一级学科下设立“模式识别与智能系统”二级学科，并于2001年获评全国重点学科 1986年 成立人工智能与机器人研究所，开展硕士、博士研究生培养 1982年 在“控制科学与工程”一级学科下设立“模式识别与智能系统”二级学科，并于2001年获评全国重点学科 1986年 成立人工智能与机器人研究所，开展硕士、博士研究生培养 2017年 创建人工智能拔尖人才培养试验班 2019年 获首批人工智能本科新专业建设资格 2022年 获批人工智能交叉学科博士学位授权点 一流教学科研平台 广阔就业前景 多年来，毕业硕博士研究生就业形势持续喜人，就业率100%。",
    "任务原句": "宣讲会信息 2024年7月21日，人工智能与机器人研究所暨人工智能学院召开2025年度研究生招生宣讲会，欢迎相关专业的同学踊跃报名参会。",
    "明示金额": "",
    "关键条件": "",
    "缺口或身份说明": ""
  },
