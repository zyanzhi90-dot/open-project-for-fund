<script>

	var u = navigator.userAgent;
	var isAndroid = u.indexOf('Android') > -1 || u.indexOf('Linux') > -1; //g
	var isIOS = !!u.match(/\(i[^;]+;( U;)? CPU.+Mac OS X/); //ios终端
	if(isAndroid || isIOS){
		var menuIndex = sessionStorage.getItem("menuIndex");
	   	menuIndex = menuIndex >-1?menuIndex:0;
	   	sessionStorage.setItem("menuIndex",menuIndex);
	   	$(".sec_menu_li").eq(menuIndex).addClass('sec_menu_li_active');
	   	var navTitle = sessionStorage.getItem("navTitle");
	   	if(navTitle != null){
	   		$("#navTitle").html(navTitle);
	   	}
	}else{
		var firstMenuIndex = sessionStorage.getItem("firstMenuIndex");
		var menuIndex = sessionStorage.getItem("secMenuIndex");
		firstMenuIndex = firstMenuIndex>-1?firstMenuIndex:1;
		menuIndex = menuIndex >-1?menuIndex:0;
		sessionStorage.setItem("firstMenuIndex",firstMenuIndex);
		sessionStorage.setItem("secMenuIndex",menuIndex);
		$("#nav_" + firstMenuIndex + " .sec_menu_pc_" + menuIndex).addClass('sec_menu_pc_active');
	}

   	
   	
   	function openMenu(){
   		$("#menuIco").hide();
   		$("#menuClose").css("display","block");
   		$("#secMenuWrap").show();
   	}
   	function closeMenu(){
   		$("#menuClose").hide();
   		$("#menuIco").css("display","block");
   		$("#secMenuWrap").hide();
   	}

	function openIndex(){
		sessionStorage.setItem("menuIndex",0);
		sessionStorage.setItem("navTitle","首页");
		sessionStorage.setItem("tabIndex",0);
		window.location.href = "/home/index";
	}
	function openUrl(id,index,categoryName){
		sessionStorage.setItem("menuIndex",index);
		sessionStorage.setItem("navTitle",categoryName);
		sessionStorage.setItem("tabIndex",0);
		window.location.href = "/home/category/news/" + id;
	}
	
	function openUrlPc(id,index,secIndex,categoryName){
		if(id==60){
			window.open("/manage/index") ;
		}else{
			sessionStorage.setItem("firstMenuIndex",index);
			sessionStorage.setItem("secMenuIndex",secIndex);
			window.location.href = "/home/category/news/" + id;	
		}
		
	}
</script>


