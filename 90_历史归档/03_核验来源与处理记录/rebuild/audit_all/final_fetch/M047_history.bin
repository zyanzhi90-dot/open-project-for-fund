<script>
	var tabIndex = sessionStorage.getItem("tabIndex");
	tabIndex = tabIndex >-1?tabIndex:0;
	$(".tab_li").eq(tabIndex).addClass('link_active');
	
	function goNews(id,tabIndex){
		sessionStorage.setItem("tabIndex",tabIndex);
		sessionStorage.setItem("secMenuIndex",tabIndex);
		if(id==60){
			window.open("/manage/index") ;
		}else{
			window.location.href = "/home/category/news/"+id;
		}
	}
</script>
